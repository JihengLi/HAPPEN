# Author: Jiheng Li
# Email: jiheng.li.1@vanderbilt.edu

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /uvx /bin/

ARG HAPPEN_VERSION="0.1.3"
ARG VCS_REF="unknown"

LABEL org.opencontainers.image.title="HAPPEN" \
      org.opencontainers.image.source="https://github.com/MASILab/HAPPEN" \
      org.opencontainers.image.version="${HAPPEN_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="LicenseRef-HAPPEN-NonCommercial-Academic" \
      org.opencontainers.image.authors="Jiheng Li <jiheng.li.1@vanderbilt.edu>"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG ANTS_VERSION=2.6.2

# System packages & Python 3.11 & uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    curl \
    git \
    build-essential \
    tini \
    unzip \
    libglib2.0-0 \
    libgomp1 \
    fd-find \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    && rm -rf /var/lib/apt/lists/*

RUN uv --version

RUN ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3

# Install ANTs 2.6.2
RUN python - <<'PY' > /tmp/ants_asset_url.txt
import json
import os
import sys
import urllib.request

version = os.environ["ANTS_VERSION"]
api_url = f"https://api.github.com/repos/ANTsX/ANTs/releases/tags/v{version}"

with urllib.request.urlopen(api_url) as resp:
    data = json.load(resp)

assets = data.get("assets", [])
if not assets:
    raise SystemExit(f"No assets found for ANTs v{version}")

preferred = []
fallback = []

for asset in assets:
    name = asset["name"].lower()
    url = asset["browser_download_url"]

    is_archive = name.endswith(".zip") or name.endswith(".tar.gz") or name.endswith(".tgz")
    is_linux = ("ubuntu" in name or "linux" in name)
    is_x64 = ("x64" in name or "amd64" in name or "x86_64" in name)

    if is_archive and is_linux and is_x64:
        if "22.04" in name or "ubuntu-22.04" in name or "ubuntu22.04" in name:
            preferred.append((name, url))
        else:
            fallback.append((name, url))

candidates = preferred or fallback
if not candidates:
    names = "\n".join(a["name"] for a in assets)
    raise SystemExit(
        "Could not find a suitable ANTs Linux x64 archive asset. "
        f"Available assets:\n{names}"
    )

chosen = sorted(candidates, key=lambda x: (0 if "22.04" in x[0] else 1, len(x[0]), x[0]))[0]
print(chosen[1])
PY

RUN mkdir -p /opt/ants_download /opt/ants \
    && ANTS_URL="$(cat /tmp/ants_asset_url.txt)" \
    && echo "Downloading ANTs from: ${ANTS_URL}" \
    && curl -L "${ANTS_URL}" -o /tmp/ants_archive \
    && (unzip -q /tmp/ants_archive -d /opt/ants_download || tar -xf /tmp/ants_archive -C /opt/ants_download) \
    && FIRST_DIR="$(find /opt/ants_download -mindepth 1 -maxdepth 1 -type d | head -n 1)" \
    && test -n "${FIRST_DIR}" \
    && cp -a "${FIRST_DIR}/." /opt/ants/ \
    && rm -rf /opt/ants_download /tmp/ants_archive /tmp/ants_asset_url.txt

ENV PATH="/opt/ants/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/ants/lib:${LD_LIBRARY_PATH:-}"

# App install
WORKDIR /app

COPY pyproject.toml uv.lock README.md LICENSE.pdf ./
COPY src ./src
COPY resources ./resources
COPY docker/entrypoint.sh /usr/local/bin/happen-entrypoint

RUN chmod +x /usr/local/bin/happen-entrypoint

ENV PATH="/app/.venv/bin:/opt/ants/bin:${PATH}"

RUN uv sync --frozen

# Smoke tests
RUN python -c "import happen; print('happen import OK')"
RUN python -c "from deepbet import run_bet; print('deepbet import OK')"
RUN antsRegistration --version
RUN N4BiasFieldCorrection --version

# Runtime defaults
WORKDIR /workspace
EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/happen-entrypoint"]